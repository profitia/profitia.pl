# ──────────────────────────────────────────────────────────────
# Profitia.pl - environment variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────────

# Database (NeonDB PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Dedicated Forms DB - canonical contact/newsletter database.
# Keep the same format as DATABASE_URL and never commit real credentials.
DATABASE_FORMS_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Recruitment CV private storage root.
# Production Render Disk mount: /var/data/recruitment-cv
RECRUITMENT_CV_STORAGE_PATH="/var/data/recruitment-cv"

# Canonical recruiter notification mailbox for production.
RECRUITMENT_NOTIFICATION_TO="monika.osiecka@profitia.pl"

# Legacy fallback - keep only during transition if DATABASE_FORMS_URL is not yet present.
# DATABASE_CONTACT_FORM_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# JWT secret for admin sessions (generate with: openssl rand -base64 64)
JWT_SECRET="change-me-to-a-long-random-string"
# HMAC secret for pseudonymous admin login IP/e-mail keys (minimum 32 random bytes)
ADMIN_AUTH_HMAC_SECRET="change-me-to-a-different-long-random-string"

# Application URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudflare R2 media storage (server-only)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_PUBLIC_BASE_URL="https://media.example.com"

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
TURNSTILE_ALLOWED_HOSTNAMES="profitia.pl,www.profitia.pl,profitia-pl.onrender.com"
TURNSTILE_EXPECTED_ACTION="contact_form"

# Contact anti-abuse policy
# Timing is a lightweight heuristic only - Turnstile remains the primary bot defense.
CONTACT_MIN_FILL_TIME_MS="800"
# In-memory rate limiting is process-local: restarts clear counters and multi-instance deployments do not share them.
CONTACT_RATE_LIMIT_WINDOW_MS="600000"
CONTACT_RATE_LIMIT_MAX_PER_IP="10"
CONTACT_RATE_LIMIT_EMAIL_WINDOW_MS="1800000"
CONTACT_RATE_LIMIT_MAX_PER_EMAIL="3"

# ──────────────────────────────────────────────────────────────
# Integrations - not yet active, prepare when ready
# ──────────────────────────────────────────────────────────────

# OpenAI (chat widget)
OPENAI_API_KEY="sk-..."
OPENAI_PRIMARY_MODEL="gpt-4.1"
# OPENAI_FALLBACK_MODEL="gpt-4.1-mini"

# Microsoft Teams booking
# TEAMS_BOOKING_URL="https://teams.microsoft.com/..."

# home.pl SMTP - canonical contact form transport
MAILBOX_LOGIN="kontakt@example.com"
MAILBOX_PASSWORD="your-mailbox-password"
MAILBOX_SMTP_HOST="smtp.example.com"
MAILBOX_SMTP_PORT="465"
MAILBOX_SMTP_SECURE="true"
CONTACT_NOTIFICATION_EMAIL="kontakt@profitia.pl"
CONTACT_NOTIFICATION_BCC="tomasz.uscinski@profitia.pl"

# Microsoft 365 / Graph - server-only adapter retained for non-contact-form uses
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
MAIL_FROM="sender@profitia.pl"
# Preferred reuse path from Kampanie Apollo: delegated MSAL cache stored as secret.
MSAL_TOKEN_CACHE_B64="base64-encoded-serialized-msal-cache"
# Optional delegated scopes override. Default: Mail.Send,User.Read
MAIL_SCOPES="Mail.Send,User.Read"
# Optional fallback for app-only/client-credentials auth if the tenant is configured for it.
# AZURE_CLIENT_SECRET="replace-with-app-secret"

# Mailchimp newsletter
# MAILCHIMP_API_KEY="..."
# MAILCHIMP_AUDIENCE_ID="0a36468d05"

# Newsletter anti-abuse
NEWSLETTER_MIN_FILL_TIME_MS="800"
NEWSLETTER_RATE_LIMIT_WINDOW_MS="600000"
NEWSLETTER_RATE_LIMIT_MAX_PER_IP="10"
NEWSLETTER_RATE_LIMIT_EMAIL_WINDOW_MS="3600000"
NEWSLETTER_RATE_LIMIT_MAX_PER_EMAIL="3"

# Recruitment anti-abuse
# These values are optional because the recruitment route ships with safe defaults.
RECRUITMENT_MIN_FILL_TIME_MS="800"
RECRUITMENT_RATE_LIMIT_WINDOW_MS="600000"
RECRUITMENT_RATE_LIMIT_MAX_PER_IP="5"
RECRUITMENT_RATE_LIMIT_EMAIL_WINDOW_MS="3600000"
RECRUITMENT_RATE_LIMIT_MAX_PER_EMAIL="3"
