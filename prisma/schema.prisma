// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleLocale {
  PL
  EN
}

// ---------------------------------------------------------------------------
// Blog articles (CMS)
// ---------------------------------------------------------------------------
model Article {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug               String
  locale             ArticleLocale?
  translationGroupId String?
  title              String
  excerpt            String?        @db.Text
  content            String         @db.Text

  published   Boolean   @default(false)
  publishedAt DateTime?

  // SEO
  metaTitle       String?
  metaDescription String?

  // Authorship
  author   AdminUser? @relation(fields: [authorId], references: [id])
  authorId String?

  // ── Editorial System ────────────────────────────────────────────────────
  // Category slug - must match ArticleCategorySlug in lib/content/types.ts
  category      String?
  // Estimated reading time in minutes
  readingTime   Int?
  // Cover image - public path (e.g. /images/articles/...) or absolute URL
  coverImage    String?
  coverImageAlt String?
  coverMedia    Media?  @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  coverMediaId  String?
  // Whether this article is the featured/lead article on the index
  featured      Boolean @default(false)
  // Subtitle / standfirst - shown in article hero below title
  subtitle      String? @db.Text

  // Author (denormalized - supplements AdminUser relation for editorial display)
  authorName String?
  authorRole String?
  authorBio  String? @db.Text

  // Related content - slugs resolved at query time
  relatedSlugs String[] @default([])

  @@unique([locale, slug])
  @@unique([translationGroupId, locale])
  @@index([coverMediaId])
  @@map("articles")
}

model Media {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  storageKey String @unique
  publicUrl  String @unique
  mimeType   String
  width      Int
  height     Int
  byteSize   Int

  uploadedBy    AdminUser @relation(fields: [uploadedById], references: [id])
  uploadedById  String
  coverArticles Article[]

  @@index([uploadedById])
  @@map("media")
}

// ---------------------------------------------------------------------------
// Admin users (CMS access)
// ---------------------------------------------------------------------------
model AdminUser {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email        String @unique
  name         String
  passwordHash String

  active Boolean @default(true)

  articles Article[]
  media       Media[]
  loginAudits AdminLoginAudit[]

  @@map("admin_users")
}

model AdminLoginAudit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  adminUserId String?
  emailKey    String
  ipKey       String
  outcome     String
  userAgent   String?    @db.VarChar(512)

  @@index([ipKey, createdAt])
  @@index([emailKey, createdAt])
  @@index([adminUserId])
  @@map("admin_login_audits")
}
