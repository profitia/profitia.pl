generator client {
  provider = "prisma-client-js"
  output   = "../generated/forms-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_FORMS_URL")
}

enum SubmissionStatus {
  NEW
  READ
  IN_PROGRESS
  CLOSED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum ContactEmailKind {
  INTERNAL_NOTIFICATION
  USER_CONFIRMATION
}

enum ContactEmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum JobPosition {
  PROCUREMENT_CONSULTANT
  JUNIOR_BUSINESS_ANALYST
  MANAGER
}

enum WeeklyAvailability {
  HOURS_20_30
  HOURS_30_40
  HOURS_40
}

enum ExcelLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum EnglishLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
  FLUENT
}

enum CvStorageStatus {
  PENDING
  STORED
  FAILED
}

enum JobApplicationStatus {
  RECEIVED
  IN_REVIEW
  REJECTED
  HIRED
  WITHDRAWN
}

enum ExternalSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
}

model ContactSubmission {
  id                         String              @id @default(cuid())
  fullName                   String
  email                      String
  company                    String?
  topic                      String?
  message                    String              @db.Text
  privacyConsent             Boolean
  privacyConsentText         String              @db.Text
  privacyConsentVersion      String
  marketingConsent           Boolean
  marketingConsentText       String              @db.Text
  marketingConsentVersion    String
  lawfulBasis                String?
  privacyPolicyUrl           String?
  privacyPolicyVersion       String?
  locale                     String
  sourcePage                 String?
  submissionStatus           SubmissionStatus    @default(NEW)
  internalEmailStatus        EmailDeliveryStatus @default(PENDING)
  internalEmailSentAt        DateTime?
  internalEmailMessageId     String?
  internalEmailError         String?             @db.Text
  confirmationEmailStatus    EmailDeliveryStatus @default(PENDING)
  confirmationEmailSentAt    DateTime?
  confirmationEmailMessageId String?
  confirmationEmailError     String?             @db.Text
  submittedAt                DateTime            @default(now())
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  emailOutboxJobs            ContactEmailOutbox[]

  @@map("contact_submissions")
  @@index([submittedAt])
  @@index([submissionStatus])
  @@index([email])
  @@index([internalEmailStatus])
  @@index([confirmationEmailStatus])
}

model ContactEmailOutbox {
  id                  String                @id @default(cuid())
  contactSubmissionId String
  contactSubmission   ContactSubmission     @relation(fields: [contactSubmissionId], references: [id], onDelete: Cascade)
  kind                ContactEmailKind
  status              ContactEmailJobStatus @default(PENDING)
  attempts            Int                   @default(0)
  availableAt         DateTime              @default(now())
  lockedAt            DateTime?
  lastAttemptAt       DateTime?
  sentAt              DateTime?
  messageId           String?
  lastError           String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@map("contact_email_outbox")
  @@unique([contactSubmissionId, kind])
  @@index([status, availableAt])
  @@index([lockedAt])
}

model NewsletterSubscription {
  id                    String             @id @default(cuid())
  email                 String             @unique
  privacyConsent        Boolean
  privacyConsentText    String             @db.Text
  privacyConsentVersion String
  lawfulBasis           String?
  locale                String
  sourcePage            String?
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  subscribedAt          DateTime           @default(now())
  confirmedAt           DateTime?
  unsubscribedAt        DateTime?
  externalContactId     String?
  confirmationEmailStatus    EmailDeliveryStatus?
  confirmationEmailSentAt    DateTime?
  confirmationEmailMessageId String?
  confirmationEmailError     String?             @db.Text
  mailchimpSyncStatus        ExternalSyncStatus?
  mailchimpSyncedAt          DateTime?
  mailchimpSubscriberHash    String?
  mailchimpError             String?             @db.Text
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@map("newsletter_subscriptions")
  @@index([subscribedAt])
  @@index([subscriptionStatus])
  @@index([locale])
  @@index([mailchimpSyncStatus])
}

model JobApplication {
  id                                String                @id @default(cuid())
  position                          JobPosition
  fullName                          String
  email                             String
  phone                             String
  availableFrom                     String
  weeklyAvailability                WeeklyAvailability?
  hybridAccepted                    Boolean
  businessTravelAccepted            Boolean
  excelLevel                        ExcelLevel
  englishLevel                      EnglishLevel
  financialExpectations             String?
  motivation                        String                @db.Text
  cvOriginalFilename                String?
  cvMimeType                        String?
  cvSizeBytes                       Int?
  cvStorageKey                      String?
  cvSha256                          String?
  cvStorageStatus                   CvStorageStatus?
  currentRecruitmentConsent         Boolean
  currentRecruitmentConsentText     String                @db.Text
  currentRecruitmentConsentVersion  String
  currentRecruitmentConsentAt       DateTime
  futureRecruitmentConsent          Boolean
  futureRecruitmentConsentText      String?               @db.Text
  futureRecruitmentConsentVersion   String?
  futureRecruitmentConsentAt        DateTime?
  locale                            String
  sourcePage                        String?
  applicationStatus                 JobApplicationStatus  @default(RECEIVED)
  internalEmailStatus               EmailDeliveryStatus?
  internalEmailSentAt               DateTime?
  internalEmailMessageId            String?
  internalEmailError                String?               @db.Text
  candidateEmailStatus              EmailDeliveryStatus?
  candidateEmailSentAt              DateTime?
  candidateEmailMessageId           String?
  candidateEmailError               String?               @db.Text
  submittedAt                       DateTime              @default(now())
  createdAt                         DateTime              @default(now())
  updatedAt                         DateTime              @updatedAt

  @@map("job_applications")
  @@index([position])
  @@index([email])
  @@index([applicationStatus])
  @@index([submittedAt])
}

model AdvisoryConversation {
  id             String   @id @default(cuid())
  visitorKeyHash String   @map("visitor_key_hash")
  sessionId      String   @map("session_id")
  locale         String
  advisorId      String   @map("advisor_id")
  title          String
  messages       Json
  intentCode     String?  @map("intent_code")
  destinationId  String?  @map("destination_id")
  recommendation Json?
  ipAddress      String?  @db.Inet @map("ip_address")
  startedAt      DateTime @map("started_at")
  lastActivityAt DateTime @map("last_activity_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([visitorKeyHash, sessionId])
  @@index([visitorKeyHash, lastActivityAt])
  @@map("advisory_conversations")
}
